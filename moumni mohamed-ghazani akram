// server.js - VERSION CORRIGÉE POUR AZURE
import express from 'express';
import OpenAI from 'openai';
import path from 'path';
import { fileURLToPath } from 'url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const app = express();
const PORT = process.env.PORT || 3000;

// Middleware
app.use(express.json());
app.use(express.static('public'));

// Configuration Azure OpenAI
const client = new OpenAI({
  apiKey: "keyApi",
  baseURL: "https://ghaza-mhud2eqf-eastus2.cognitiveservices.azure.com/openai/deployments/GhDeployement/",
  defaultQuery: { "api-version": "2024-02-01" }
});

// Route pour la page d'accueil
app.get('/', (req, res) => {
  res.sendFile(path.join(__dirname, 'public', 'index.html'));
});

// Route API pour le chat
app.post("/chat", async (req, res) => {
  try {
    const userMessage = req.body.message;
    
    if (!userMessage) {
      return res.status(400).json({ error: "Le message est requis" });
    }

    console.log('📨 Message reçu:', userMessage);

    const response = await client.chat.completions.create({
      model: "GhDeployement",
      messages: [{ role: "user", content: userMessage }],
      max_tokens: 500,
      temperature: 0.7
    });

    const botResponse = response.choices[0].message.content;
    console.log('🤖 Réponse envoyée');

    res.json({ response: botResponse });

  } catch (error) {
    console.error('❌ Erreur:', error);
    res.status(500).json({ 
      error: "Erreur de communication avec Azure AI",
      details: error.message 
    });
  }
});

// Route de test
app.get('/test', (req, res) => {
  res.json({ 
    message: 'Serveur fonctionne sur Azure!',
    timestamp: new Date().toISOString(),
    nodeVersion: process.version
  });
});

// Démarrer le serveur
app.listen(PORT, () => {
  console.log(`🚀 Serveur démarré sur le port ${PORT}`);
});
